<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Grosse Flaechen: Die Tasten werden auch mit nassen Haenden bedient. -->
    <style name="ActionButton">
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="BackButton" parent="ActionButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MenuRow">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="ScreenTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
