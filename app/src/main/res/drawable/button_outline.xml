<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rule">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <stroke android:width="1dp" android:color="@color/rule" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <stroke android:width="2dp" android:color="@color/ink" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
